# ===== DeepSeek API（必填）=====
# 在 https://platform.deepseek.com 控制台创建，sk- 开头
DEEPSEEK_API_KEY=sk-在这里填你的Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 视觉模型名。注意：deepseek-v4-flash-vision-exp 是已退役的遗留名（仍被接受，
# 请求由 DeepSeek-V4.1-Flash 承接、按 Flash 价计费）；官方推荐的正式名是
# deepseek-flash（唯一支持视觉的正式模型，deepseek-v4-pro 不支持视觉）。
# 全项目只允许在这里和 core/config.py 出现模型名，改名只改这里。
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp

# ===== 视频源 =====
# "0" = 内置摄像头；填文件路径则整条管线进入离线回放模式，
# 例如 ./tests/media/fall_real_01.mp4（文件名必须带真实标签）
VIDEO_SOURCE=0

# ===== 外部通知 Webhook（可选）=====
# 钉钉自定义机器人 Webhook URL
DINGTALK_WEBHOOK=
# 飞书自定义机器人 Webhook URL
FEISHU_WEBHOOK=
# 通用通知 Webhook（HomeAssistant / ServerChan / PushPlus / Bark）
NOTIFY_WEBHOOK_URL=

# ===== 安全加固（对外可访问时必填）=====
# 家人端访问口令；设置后 /api/* 需要 Bearer 或 ?token=，/ws 需要 ?token=
BUTLER_TOKEN=
# 钉钉 outgoing 机器人签名密钥（启用后验签，时间戳窗口 5 分钟）
DINGTALK_SIGN_SECRET=
# 飞书 Encrypt Key（启用后校验 X-Lark-Signature）
FEISHU_SIGN_SECRET=
# 独立看门狗告警通道（与被监控系统分离）
WATCHDOG_WEBHOOK_URL=

